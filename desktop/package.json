{
  "name": "structurad-esgar-retto",
  "productName": "StructuRad ESGAR",
  "version": "0.2.1",
  "description": "StructuRad × ESGAR — RM Retto, programma per Windows",
  "author": "StructuRad",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prova": "electron . --prova",
    "locale": "electron . --tool-locale",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "it.structurad.esgar.retto",
    "productName": "StructuRad ESGAR",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ponte.js",
      "prova.html",
      "build/icon.png",
      {
        "from": "..",
        "to": "tool",
        "filter": [
          "index.html",
          "manifest.webmanifest",
          "icone/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StructuRad ESGAR",
      "artifactName": "StructuRad-ESGAR-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": true,
      "perMachine": true,
      "upgradeCode": "0DF89CBF-D6E9-4C9F-89BE-BDC75801C6E9",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StructuRad ESGAR",
      "artifactName": "StructuRad-ESGAR-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StructuRad-ESGAR-portatile-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "radios4ndbox-bot",
        "repo": "Tool-beta-RM-Rectal"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/radios4ndbox-bot/Tool-beta-RM-Rectal.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
